# Copy this file to .env.local and fill it in. Never commit .env.local.

# Your HonkIO API key, from https://honkio.ca/dashboard/keys
# Start with a test key (mk_test_...): nothing is sent and nothing is charged.
HONKIO_API_KEY=

# The number your texts come from, in E.164 (+1 and ten digits).
# Live key: one of your HonkIO numbers.
# Test key: any valid Canadian number works, so you can try this before you buy one.
HONKIO_FROM_NUMBER=

# Who is asking for consent. CASL wants the customer to see your name and a
# way to reach you (a mailing address plus a phone number, email or website)
# next to the opt-in box. Both are shown on the booking form and kept with
# each consent record. BUSINESS_CONTACT is required, for example:
#   100 King St W, Toronto ON, hello@yourclinic.ca
# In production the app refuses the name Acme Clinic and any example.com address.
BUSINESS_NAME=Acme Clinic
BUSINESS_CONTACT=

# The time zone appointments are booked in (an IANA name).
BUSINESS_TIMEZONE=America/Toronto

# How long before the appointment the reminder goes out: whole hours, 1 to 720.
REMINDER_HOURS_BEFORE=24

# Confirm each number before texting it: the booking texts the number a
# HonkIO Verify code, and the confirmation and reminder go out (and consent
# is recorded) only once the code is entered. Each code is charged like any
# verification. Recommended for a public form.
# CONFIRM_PHONE=true

# Only when CONFIRM_PHONE is not set. Anyone can type any number into the
# form, so when NODE_ENV is production (`npm start` and every host) the app
# saves bookings but texts nobody, and logs why, unless this is true. Set it
# only with another guard on the form, such as a CAPTCHA.
# ALLOW_UNCONFIRMED_BOOKINGS=true

# Your site's address, kept with each consent record as where the box was
# ticked. Optional while you try it locally; set it in production.
# APP_URL=https://book.example.com

# How many proxies in front of the app add to X-Forwarded-For. Required in
# production, except on Vercel and Fly.io, which pass the visitor's IP in
# their own header. 0 for a bare `next start` with nothing in front (the
# per-IP limit is then off and consent records get no IP; the per-number
# limits stay), 1 behind one proxy (Railway, Render, nginx). Defaults to 1 in
# development.
# TRUSTED_PROXY_HOPS=1

# Optional: the signing secret of a HonkIO webhook pointed at
# https://<your site>/api/webhooks/honkio (shown once when you create it).
HONKIO_WEBHOOK_SECRET=

# Optional: where bookings are kept. Default: data/bookings.json
# BOOKINGS_FILE=data/bookings.json
